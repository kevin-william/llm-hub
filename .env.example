POSTGRES_DB=llmhub
POSTGRES_USER=llmhub
POSTGRES_PASSWORD=local-development-only
MINIO_ROOT_USER=llmhub
MINIO_ROOT_PASSWORD=local-development-only
ConnectionStrings__Hub=Host=localhost;Port=5432;Database=llmhub;Username=llmhub;Password=local-development-only
Database__ApplyMigrations=true
ConnectionStrings__Redis=localhost:6379
Workers__EnableOutboxPublisher=false
ArtifactStorage__Endpoint=localhost:9000
ArtifactStorage__AccessKey=llmhub
ArtifactStorage__SecretKey=local-development-only
ArtifactStorage__Bucket=llm-hub-artifacts
ArtifactStorage__UseSsl=false
Hub__Quotas__MaxMessageBytes=65536
Hub__Quotas__MaxAttachments=16
Hub__Quotas__MaxActiveRunsPerPrincipal=10
Hub__Quotas__MaxChannelsPerPrincipal=100
Hub__Quotas__MaxActiveSubscriptionsPerPrincipal=20
Workers__EnableRetention=false
Retention__AuditDays=90
Retention__WebhookDeliveryDays=30
Webhook__SecretEncryptionKey=
# During a key rotation, keep older comma-separated Base64 keys here until all subscriptions encrypted with them expire or are replaced.
Webhook__PreviousSecretEncryptionKeys=
